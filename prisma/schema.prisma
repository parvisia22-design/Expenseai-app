generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ──────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  accounts      Account[]
  sessions      Session[]

  trips         Trip[]
  places        Place[]
  routePresets  RoutePreset[]
  purposeLinks  PurposeLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────
enum AttachmentType {
  RECEIPT
  TOLL
  PARKING
  MILEAGE
  OTHER
}

enum TripStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REIMBURSED
}

model Place {
  id        String   @id @default(cuid())
  userId    String
  name      String
  aliases   String[]
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tripsAsOrigin Trip[] @relation("TripOrigin")
  tripsAsDest   Trip[] @relation("TripDest")
  purposeLinks  PurposeLink[]
  presetsAsOrigin RoutePreset[] @relation("PresetOrigin")
  presetsAsDest   RoutePreset[] @relation("PresetDest")

  @@unique([userId, name])
  @@index([userId])
}

model Trip {
  id            String     @id @default(cuid())
  userId        String
  date          DateTime
  purpose       String
  originId      String?
  destId        String?
  mileageKm     Float?
  tollAmount    Int        @default(0)
  parkingAmount Int        @default(0)
  mealAmount    Int        @default(0)
  otherAmount   Int        @default(0)
  totalAmount   Int        @default(0)
  status        TripStatus @default(DRAFT)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin      Place?       @relation("TripOrigin", fields: [originId], references: [id])
  destination Place?       @relation("TripDest",   fields: [destId],   references: [id])
  attachments Attachment[]

  @@index([userId, date])
  @@index([userId, purpose])
}

model Attachment {
  id        String         @id @default(cuid())
  tripId    String
  type      AttachmentType
  imageUrl  String
  amount    Int?
  ocrJson   Json?
  createdAt DateTime       @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model RoutePreset {
  id          String   @id @default(cuid())
  userId      String
  originId    String
  destId      String
  distanceKm  Float
  avgToll     Int      @default(0)
  avgParking  Int      @default(0)
  samples     Int      @default(1)
  updatedAt   DateTime @updatedAt

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin Place @relation("PresetOrigin", fields: [originId], references: [id], onDelete: Cascade)
  dest   Place @relation("PresetDest",   fields: [destId],   references: [id], onDelete: Cascade)

  @@unique([userId, originId, destId])
}

model PurposeLink {
  id        String   @id @default(cuid())
  userId    String
  purpose   String
  placeId   String
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose, placeId])
  @@index([userId, purpose])
  @@index([userId, placeId])
}
