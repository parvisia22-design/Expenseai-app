generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js models ──────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime  @default(now())

  // Profile (shown on the reimbursement form as Nama Karyawan / Divisi)
  displayName    String?
  division       String?
  employeeNumber String?

  accounts      Account[]
  sessions      Session[]

  reimbursements Reimbursement[]
  expenseLines   ExpenseLine[]
  places         Place[]
  routePresets   RoutePreset[]
  purposeLinks   PurposeLink[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain models ───────────────────────────────────────────────
enum ExpenseType {
  // Current canonical categories (match Stitch reimbursement form)
  TICKETS
  HOTEL
  RENTAL_CAR
  TRANSPORT
  TOLL_PARKING
  PETROL
  MILEAGE
  MEAL
  ENTERTAINMENT
  EXTRA
  OTHER

  // Deprecated (kept so historic rows still validate)
  TOLL
  PARKING
  FUEL
  LODGING
}

enum ReimbursementStatus {
  DRAFT
  SUBMITTED           // Menunggu Supervisor
  SUPERVISOR_APPROVED // Menunggu Finance
  FINANCE_APPROVED    // Fully approved, ready for payout
  REIMBURSED          // Paid
  REJECTED
}

model Place {
  id        String   @id @default(cuid())
  userId    String
  name      String
  aliases   String[]
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  linesAsOrigin   ExpenseLine[] @relation("LineOrigin")
  linesAsDest     ExpenseLine[] @relation("LineDest")
  purposeLinks    PurposeLink[]
  presetsAsOrigin RoutePreset[] @relation("PresetOrigin")
  presetsAsDest   RoutePreset[] @relation("PresetDest")

  @@unique([userId, name])
  @@index([userId])
}

// The parent form — one row = one printable "Formulir Reimbursement Perjalanan Dinas".
model Reimbursement {
  id             String              @id @default(cuid())
  userId         String
  title          String              // "Perjalanan Dinas Jakarta - Bandung"
  purpose        String              // Tujuan
  visitedPlace   String?             // Tempat yang dikunjungi (freeform)
  periodStart    DateTime            // Jangka Waktu (start)
  periodEnd      DateTime            // Jangka Waktu (end)
  status         ReimbursementStatus @default(DRAFT)
  totalAmount    Int                 @default(0)  // sum of lines
  currency       String              @default("IDR")
  notes          String?
  submittedAt    DateTime?
  supervisorAt   DateTime?
  financeAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines ExpenseLine[]

  @@index([userId, periodStart])
  @@index([userId, status])
}

// Rincian Biaya — a single row in the reimbursement's expense table.
model ExpenseLine {
  id              String      @id @default(cuid())
  userId          String
  reimbursementId String?
  date            DateTime
  type            ExpenseType
  purpose         String?     // Tujuan (optional, defaults to parent)
  originId        String?
  destId          String?
  placeText       String?     // freeform Tempat when no Place row
  description     String?
  unit            String?     // "L", "km", "trip", "pax"
  quantity        Float?
  unitPrice       Int?
  amount          Int         @default(0)
  mileageKm       Float?
  ocrJson         Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reimbursement Reimbursement? @relation(fields: [reimbursementId], references: [id], onDelete: SetNull)
  origin        Place?         @relation("LineOrigin", fields: [originId], references: [id])
  destination   Place?         @relation("LineDest",   fields: [destId],   references: [id])
  attachments   Attachment[]

  @@index([userId, date])
  @@index([reimbursementId])
}

model Attachment {
  id            String   @id @default(cuid())
  expenseLineId String
  imageUrl      String
  amount        Int?
  ocrJson       Json?
  createdAt     DateTime @default(now())

  line ExpenseLine @relation(fields: [expenseLineId], references: [id], onDelete: Cascade)

  @@index([expenseLineId])
}

model RoutePreset {
  id         String   @id @default(cuid())
  userId     String
  originId   String
  destId     String
  distanceKm Float
  avgToll    Int      @default(0)
  avgParking Int      @default(0)
  samples    Int      @default(1)
  updatedAt  DateTime @updatedAt

  user   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  origin Place @relation("PresetOrigin", fields: [originId], references: [id], onDelete: Cascade)
  dest   Place @relation("PresetDest",   fields: [destId],   references: [id], onDelete: Cascade)

  @@unique([userId, originId, destId])
}

model PurposeLink {
  id        String   @id @default(cuid())
  userId    String
  purpose   String
  placeId   String
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose, placeId])
  @@index([userId, purpose])
  @@index([userId, placeId])
}
