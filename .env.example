# ── Railway-provided ─────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/expense_ai"
PORT=3000

# ── Auth.js ──────────────────────────────────────────────────────
AUTH_SECRET=            # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (developer.apple.com → Services ID + key)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=    # signed JWT, regenerate every ~6 months

# Email magic link (any SMTP; Resend/Postmark/SendGrid work)
EMAIL_SERVER="smtp://user:pass@smtp.host:587"
EMAIL_FROM="ExpenseAI <no-reply@yourdomain.com>"

# ── AI / OCR ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Google Maps Distance Matrix ──────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_PRIMARY=#4F46E5
